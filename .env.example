# .env 로 복사해서 쓴다. .env 는 git 에 올리지 않는다.
# 아래 두 값은 영문·숫자로 길게 바꿔 쓴다(HTTP 헤더에 한글은 못 넣는다).
AUTHOR_HASH_SALT=change-me-local-salt-0000
ADMIN_API_KEY=change-me-admin-key-0000
# AI 에이전트(MCP 서버) 전용 키 — 사람 키와 다른 값으로. 비워 두면 에이전트는 조회만 된다
AGENT_API_KEY=

# 중복 묶기 기준(0~1). 높을수록 덜 묶는다.
DUPLICATE_THRESHOLD=0.20
# 분류가 같은 이슈끼리만 묶기(P9). 끄면 글자만 보고 묶는다 — 그때는 기준을 0.55 로 올릴 것
DUPLICATE_SAME_CATEGORY_ONLY=true
# 슬랙 카드마다 게임별 봇 이름·아이콘(슬랙 앱에 chat:write.customize 권한 추가·재설치 후 true)
SLACK_CUSTOM_IDENTITY=false
# 해결한 지 이 기간(일) 안에 비슷한 제보가 오면 재발 의심으로 표시
RECURRENCE_WINDOW_DAYS=30

# LLM 분류 (기본 꺼짐 — 꺼져 있으면 키워드 규칙으로 분류)
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 슬랙 (기본 꺼짐 — 꺼져 있으면 알림은 서버 로그로만)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# 공용 채널 — 게임별 채널은 config/games.json. 게임 채널이 없을 때와 실패했을 때 여기로 간다
SLACK_CHANNEL_DEFAULT=
SLACK_CHANNEL_URGENT=
SLACK_ADMIN_USER_IDS=

# 디스코드 (기본 꺼짐)
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# 게임별 제보 채널은 config/games.json. 아래는 예전 방식(여기 적은 채널은 기본 게임으로 받음)
DISCORD_REPORT_CHANNEL_IDS=
DISCORD_DEFAULT_GAME=gemtower

# 개발 AI에게 넘기기(슬랙 피드백 정리 카드 버튼) — 깃허브 Fine-grained 토큰, 게임 저장소(games.json 의 repo) Issues: Read and write
GITHUB_TOKEN=

# Jira 버그 티켓(슬랙 피드백 정리 카드 버튼) — 게임별 프로젝트 키는 games.json 의 jiraProject
# API 토큰: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# 서버가 부르는 AI 한 달 예산(달러). 넘으면 이번 달은 분류는 키워드 규칙, 보고서는 기록만으로. 0 이면 제한 없음
AI_MONTHLY_BUDGET_USD=5
# 도배 막기: 제보가 운영자가 다룬 이슈에 들어간 적 있는 사람의 10분 한도(실적 없는 사람은 3, 믿는 사람·우수 테스터는 10)
INTAKE_MAX_PER_10MIN=5
# (선택) 디스코드 역할 이름이나 ID, 쉼표로. 비우면 「우수 테스터」(10분 10건·몰려도 바로 접수). 운영진은 제한 없음
DISCORD_MEMBER_ROLES=
DISCORD_STAFF_ROLES=
# 남은 Anthropic 크레딧 추정: 콘솔 Billing 에서 본 잔액과 그날(예: 2026-10-21). 충전하면 새 잔액·날짜로 바꾼다
AI_CREDIT_BALANCE_USD=
AI_CREDIT_BALANCE_AT=
# (선택) 조직 관리 키 sk-ant-admin… — 있으면 잔액에서 뺄 금액을 Anthropic 공식 집계(계정 전체 사용)로 읽는다
ANTHROPIC_ADMIN_KEY=

# 슬랙 소켓 모드: 슬랙 앱 설정 > Basic Information > App-Level Tokens 에서 connections:write 토큰(xapp-…)을 만들어 넣는다.
# 넣으면 공개 주소·중계·터널 없이 버튼·명령이 돌아가고, 서버를 껐다 켜도 슬랙 주소를 바꿀 일이 없다
SLACK_APP_TOKEN=
