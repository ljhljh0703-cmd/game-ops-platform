  "info" : {
    "description" : "플레이어 제보를 받아 분류·묶기한 이슈를 조회하고, 사람(또는 AI 에이전트)이 상태와 자동 판단을 고친다.\n바꾸는 요청은 모두 `X-Api-Key` 헤더가 필요하다. 키마다 이름이 있어 감사 기록에 누가 바꿨는지 남는다\n(사람 = local-admin, AI 에이전트 = ai-agent).\n이 서버는 내 컴퓨터 안(127.0.0.1)에서만 열리고, 인터넷에는 슬랙 버튼 주소 하나만 열린다.",
    "title" : "게임 운영 플랫폼 API",
    "version" : "0.2.0"
  },
  "openapi" : "3.0.1",
  "paths" : {
    "/api/admin/classifier/rules" : {
      "get" : {
        "operationId" : "current",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Api-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RulesView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "adminKey" : [ ]
        } ],
        "summary" : "분류 규칙 보기",
        "tags" : [ "분류 규칙" ]
      }
    },
    "/api/admin/classifier/rules/proposals" : {
      "post" : {
        "description" : "body.rules 는 config/classifier-rules.json 과 같은 모양({\"rules\":[...]}). 서버가 dev·회귀 문장으로 다시 시험하고, dev 정확도가 떨어지지 않고 결제·크래시 키워드를 빼거나 낮추지 않으면 바로 반영해 슬랙에 「되돌리기」 카드를 보낸다. 통과 못 하면 applied=false 와 이유. AI 에이전트 키로도 낼 수 있다",
        "operationId" : "propose",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Api-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProposalRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Result"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "adminKey" : [ ]
        } ],
        "summary" : "규칙 수정안 내기(시험 통과 시 바로 반영)",
        "tags" : [ "분류 규칙" ]
      }
    },
    "/api/admin/classifier/rules/versions" : {
      "get" : {
        "operationId" : "versions",
        "parameters" : [ {
