        "summary" : "API 로 반영한 규칙 기록(최근 50)",
        "tags" : [ "분류 규칙" ]
      }
    },
    "/api/admin/classifier/rules/versions/{id}/revert" : {
      "post" : {
        "description" : "파일(사람) 규칙으로 돌아간다. 슬랙 카드의 「되돌리기」와 같다",
        "operationId" : "revert",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
